<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK target is required for Windows.Media.Control (media session API). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Only used for NotifyIcon (tray) and ColorDialog. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Disabled on purpose: WPF + WinForms implicit usings create ambiguous types (Application, Color, ...). -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Crest</AssemblyName>
    <RootNamespace>Crest</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.2.0</Version>
    <Product>Crest</Product>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Keep memory low: workstation, non-concurrent GC. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core Audio (volume, default-device changes) + WASAPI loopback for the optional real spectrum. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- Brightness change events (WMI) -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- GPU usage for the System page -->
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
  </ItemGroup>

  <!-- `dotnet publish -c Release` produces a single self-contained Crest.exe -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
