<Window x:Class="Crest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:controls="clr-namespace:Crest.Controls"
        Title="Crest"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Left="0" Top="0" Width="700" Height="260">

    <!--
        The window is a fixed, fully transparent rectangle big enough for the largest notch state.
        Transparent pixels are click-through, so only the notch shape receives the mouse.
        Colors / sizes below are placeholders; MainWindow.ApplySettings() overwrites them.

        Views inside the notch (they cross-fade):
          CollapsedHost – privacy dots + time (or lyric line) + spectrum
          PeekHost      – small art + title (a new song started)
          ActivityHost  – charging, headphones, calendar, timer done, volume / brightness
          ExpandedHost  – tabbed pages: Music, Lyrics, Calendar, Weather, System, Timer, Shelf, Notes, Sound, Controls, Tools
        Next to the notch: Bubble – a running timer / stopwatch (split island).
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="NotchBackground" Color="Black" />
        <SolidColorBrush x:Key="TextBrush" Color="White" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#99FFFFFF" />
        <SolidColorBrush x:Key="TrackBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="White" />
        <SolidColorBrush x:Key="HoverBrush" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="GlowBrush" Color="#7B6CFF" />
        <FontFamily x:Key="TextFont">Segoe UI</FontFamily>
        <sys:Double x:Key="FontBase">13</sys:Double>
        <sys:Double x:Key="FontLarge">15</sys:Double>
        <sys:Double x:Key="FontSmall">11</sys:Double>

        <!-- ============ round icon button ============ -->
        <Style x:Key="MediaButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="999" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallMediaButton" TargetType="Button" BasedOn="{StaticResource MediaButton}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- ============ quick-toggle tile (Controls page) ============ -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="4,6"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ page tabs in the expanded header ============ -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ small rounded "chip" button (timer presets, modes) ============ -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource TextFont}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0,0,5,5" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ text link button ============ -->
        <Style x:Key="TextButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource TextFont}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter x:Name="Cp" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ slim slider (volume) ============ -->
        <Style x:Key="NotchSliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NotchSliderEmpty" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NotchSliderThumb" TargetType="Thumb">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="Knob" Width="10" Height="10" Fill="{DynamicResource TextBrush}" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Knob" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.25" ScaleY="1.25" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NotchSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent" MinHeight="18">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource TrackBrush}" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource NotchSliderFill}" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource NotchSliderEmpty}" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource NotchSliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotchText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource TextFont}" />
            <Setter Property="FontSize" Value="{DynamicResource FontBase}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style x:Key="SubText" TargetType="TextBlock" BasedOn="{StaticResource NotchText}">
            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontSmall}" />
        </Style>

        <Style x:Key="ArtFrame" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- thin usage bar for the System page -->
        <Style x:Key="MeterTrack" TargetType="Border">
            <Setter Property="Height" Value="5" />
            <Setter Property="CornerRadius" Value="2.5" />
            <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
        </Style>
        <Style x:Key="MeterFill" TargetType="Border">
            <Setter Property="Height" Value="5" />
            <Setter Property="CornerRadius" Value="2.5" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="RenderTransformOrigin" Value="0,0.5" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" HorizontalAlignment="Center" VerticalAlignment="Top">
        <StackPanel x:Name="ShapeRow" Orientation="Horizontal" VerticalAlignment="Top" RenderTransformOrigin="0.5,0">
            <StackPanel.RenderTransform>
                <!-- Squeezed to a thin line while you type (Behavior → Hide while typing) -->
                <ScaleTransform x:Name="ShapeScale" ScaleX="1" ScaleY="1" />
            </StackPanel.RenderTransform>

            <!-- Keeps the notch centered while the timer bubble is shown on the right. -->
            <Border x:Name="BubbleSpacer" Width="0" Visibility="Collapsed" IsHitTestVisible="False" />

            <!-- Concave "shoulder" that blends the notch into the top screen edge (Notch shape only) -->
            <Path x:Name="LeftShoulder"
                  VerticalAlignment="Top" Width="10" Height="10" Stretch="Fill"
                  Fill="{DynamicResource NotchBackground}"
                  Data="M0,0 L10,0 L10,10 A10,10 0 0 0 0,0 Z"
                  IsHitTestVisible="False" />

            <Grid x:Name="NotchStack" VerticalAlignment="Top">
                <!-- Soft album-colored glow behind the notch while music plays (driven by MainWindow.Glow.cs) -->
                <Border x:Name="GlowLayer"
                        VerticalAlignment="Top"
                        IsHitTestVisible="False"
                        Opacity="0"
                        RenderTransformOrigin="0.5,0"
                        Width="{Binding ActualWidth, ElementName=Notch}"
                        Height="{Binding ActualHeight, ElementName=Notch}"
                        CornerRadius="{Binding CornerRadius, ElementName=Notch}"
                        Background="{DynamicResource GlowBrush}">
                    <Border.Effect>
                        <BlurEffect x:Name="GlowBlur" Radius="40" KernelType="Gaussian" RenderingBias="Performance" />
                    </Border.Effect>
                    <Border.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="GlowScale" />
                            <TranslateTransform x:Name="GlowShift" Y="5" />
                        </TransformGroup>
                    </Border.RenderTransform>
                </Border>

                <Border x:Name="Notch"
                        VerticalAlignment="Top"
                        Width="220" Height="36"
                        CornerRadius="0,0,14,14"
                        Background="{DynamicResource NotchBackground}"
                        AllowDrop="True"
                        MouseEnter="Notch_MouseEnter"
                        MouseLeave="Notch_MouseLeave"
                        MouseLeftButtonDown="Notch_MouseLeftButtonDown"
                        MouseLeftButtonUp="Notch_MouseLeftButtonUp"
                        MouseRightButtonUp="Notch_MouseRightButtonUp"
                        MouseUp="Notch_MouseUp"
                        MouseWheel="Notch_MouseWheel"
                        DragEnter="Notch_DragEnter"
                        DragOver="Notch_DragOver"
                        DragLeave="Notch_DragLeave"
                        Drop="Notch_Drop">

                    <Grid x:Name="ContentRoot" ClipToBounds="True">

                        <!-- Blurred album cover behind the open player (Appearance → Effects) -->
                        <Border x:Name="CoverBackdrop" Margin="26" CornerRadius="24" Opacity="0" IsHitTestVisible="False">
                            <Border.Background>
                                <ImageBrush x:Name="CoverBackdropBrush" Stretch="UniformToFill" />
                            </Border.Background>
                            <Border.Effect>
                                <BlurEffect Radius="34" KernelType="Gaussian" RenderingBias="Performance" />
                            </Border.Effect>
                        </Border>

                        <!-- ======================= COLLAPSED ======================= -->
                        <Grid x:Name="CollapsedHost" HorizontalAlignment="Center" VerticalAlignment="Top" Width="220" Height="36">
                            <Grid Margin="14,0,16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel x:Name="LeftCluster" Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <!-- Tiny cover while music plays (Dynamic Island style) -->
                                    <Border x:Name="CollapsedArt" Width="22" Height="22" CornerRadius="6" Margin="0,0,8,0"
                                            VerticalAlignment="Center" Visibility="Collapsed">
                                        <Border.Background>
                                            <ImageBrush x:Name="CollapsedArtBrush" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>

                                    <!-- Mic / camera in use -->
                                    <StackPanel x:Name="PrivacyDots" Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="0,0,6,0" Visibility="Collapsed">
                                        <Ellipse x:Name="CamDot" Width="7" Height="7" Fill="#3DDC84" Margin="0,0,3,0" />
                                        <Ellipse x:Name="MicDot" Width="7" Height="7" Fill="#FF9F0A" />
                                    </StackPanel>

                                    <!-- Microphone muted -->
                                    <TextBlock x:Name="MicMutedIcon" FontFamily="{StaticResource IconFont}" FontSize="12" Text="&#xE720;"
                                               Foreground="#FF453A" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed" />
                                </StackPanel>

                                <TextBlock x:Name="CollapsedTime" Grid.Column="1"
                                           Style="{StaticResource NotchText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontWeight="SemiBold" Text="12:00 PM">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="TimeRoll" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>

                                <!-- Current lyric line (optional, replaces the time while playing) -->
                                <controls:MarqueeText x:Name="CollapsedLyric" Grid.Column="1"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Visibility="Collapsed"
                                                      TextElement.Foreground="{DynamicResource TextBrush}"
                                                      TextElement.FontFamily="{DynamicResource TextFont}"
                                                      TextElement.FontSize="{DynamicResource FontBase}"
                                                      TextElement.FontWeight="SemiBold" />

                                <!-- Internet speed (optional, only while nothing plays) -->
                                <TextBlock x:Name="CollapsedNet" Grid.Column="2" Style="{StaticResource SubText}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed" Text="↓ 0 KB/s" />

                                <!-- Idle buddy: a sleeping cat or a breathing dot while nothing plays (built in code) -->
                                <Canvas x:Name="IdleBuddy" Grid.Column="2" Width="26" Height="16" Margin="8,0,0,0"
                                        VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />

                                <Border x:Name="CollapsedBarsHost" Grid.Column="2"
                                        Width="0" Opacity="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        ClipToBounds="True" IsHitTestVisible="False">
                                    <StackPanel x:Name="CollapsedSpectrum" Orientation="Horizontal" HorizontalAlignment="Left"
                                                VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" />
                                </Border>
                            </Grid>

                            <!-- Thin song-progress line along the bottom of the closed notch -->
                            <Border x:Name="CollapsedProgress" Height="2" CornerRadius="1" VerticalAlignment="Bottom" Margin="16,0,16,3"
                                    Background="{DynamicResource TrackBrush}" Visibility="Collapsed" IsHitTestVisible="False">
                                <Border CornerRadius="1" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="CollapsedProgressScale" ScaleX="0" ScaleY="1" />
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                        </Grid>

                        <!-- ======================= PEEK (song changed) ======================= -->
                        <Grid x:Name="PeekHost" HorizontalAlignment="Center" VerticalAlignment="Top"
                              Width="340" Height="58" Opacity="0" Visibility="Collapsed">
                            <Grid x:Name="PeekContent" Margin="12,0,16,0" Background="Transparent"
                                  MouseLeftButtonUp="TrackInfo_MouseLeftButtonUp">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid x:Name="PeekArtContainer" Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Border Style="{StaticResource ArtFrame}" CornerRadius="9" />
                                    <TextBlock x:Name="PeekArtPlaceholder" FontFamily="{StaticResource IconFont}" Text="&#xE8D6;" FontSize="15"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                                    <Border x:Name="PeekArtImage" CornerRadius="9" Visibility="Collapsed" IsHitTestVisible="False">
                                        <Border.Background>
                                            <ImageBrush x:Name="PeekArtBrush" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <controls:MarqueeText x:Name="PeekTitle" Text="Not Playing"
                                                          TextElement.Foreground="{DynamicResource TextBrush}"
                                                          TextElement.FontFamily="{DynamicResource TextFont}"
                                                          TextElement.FontSize="{DynamicResource FontBase}"
                                                          TextElement.FontWeight="SemiBold" />
                                    <TextBlock x:Name="PeekArtist" Style="{StaticResource SubText}" TextTrimming="CharacterEllipsis" Text="" />
                                </StackPanel>

                                <StackPanel x:Name="PeekSpectrum" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="12,0,0,0" IsHitTestVisible="False" />
                            </Grid>
                        </Grid>

                        <!-- ======================= ACTIVITY (pop-ups) ======================= -->
                        <Grid x:Name="ActivityHost" HorizontalAlignment="Center" VerticalAlignment="Top"
                              Width="340" Height="58" Opacity="0" Visibility="Collapsed" Background="Transparent"
                              MouseLeftButtonUp="Activity_MouseLeftButtonUp">
                            <Grid Margin="12,0,16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="ActivityIconBg" Width="36" Height="36" CornerRadius="18" Margin="0,0,11,0"
                                        VerticalAlignment="Center" Background="#3DDC84" IsHitTestVisible="False">
                                    <TextBlock x:Name="ActivityIcon" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Text="&#xE945;" />
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="ActivityTitle" Style="{StaticResource NotchText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="ActivitySubtitle" Style="{StaticResource SubText}" TextTrimming="CharacterEllipsis" />
                                    <Grid x:Name="ActivityLevel" Height="4" Margin="0,7,0,0" Visibility="Collapsed" IsHitTestVisible="False">
                                        <Border CornerRadius="2" Background="{DynamicResource TrackBrush}" />
                                        <Border CornerRadius="2" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform x:Name="ActivityLevelScale" ScaleX="0" ScaleY="1" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </StackPanel>

                                <TextBlock x:Name="ActivityValue" Grid.Column="2" Style="{StaticResource NotchText}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                        </Grid>

                        <!-- ======================= EXPANDED ======================= -->
                        <Grid x:Name="ExpandedHost" HorizontalAlignment="Center" VerticalAlignment="Top"
                              Width="420" Height="170" Opacity="0" Visibility="Collapsed">
                            <Grid Margin="20,8,20,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Header: date · page tabs · privacy dots + time -->
                                <Grid Height="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="DateText" Style="{StaticResource SubText}" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" Text="Mon, Nov 9" />

                                    <StackPanel x:Name="TabStrip" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="TabMusic" Style="{StaticResource TabButton}" Tag="Music" ToolTip="Music" Content="&#xE8D6;" Foreground="#FF5E7E" Click="Tab_Click" />
                                        <Button x:Name="TabLyrics" Style="{StaticResource TabButton}" Tag="Lyrics" ToolTip="Lyrics" Content="&#xE8BD;" Foreground="#C084FC" Click="Tab_Click" />
                                        <Button x:Name="TabCalendar" Style="{StaticResource TabButton}" Tag="Calendar" ToolTip="Calendar" Content="&#xE787;" Foreground="#FF6B57" Click="Tab_Click" />
                                        <Button x:Name="TabWeather" Style="{StaticResource TabButton}" Tag="Weather" ToolTip="Weather" Content="&#xE706;" Foreground="#5AC8FA" Click="Tab_Click" />
                                        <Button x:Name="TabSystem" Style="{StaticResource TabButton}" Tag="System" ToolTip="System" Content="&#xE9D9;" Foreground="#34D399" Click="Tab_Click" />
                                        <Button x:Name="TabTimer" Style="{StaticResource TabButton}" Tag="Timer" ToolTip="Timer &amp; focus" Content="&#xE916;" Foreground="#FF9F0A" Click="Tab_Click" />
                                        <Button x:Name="TabShelf" Style="{StaticResource TabButton}" Tag="Shelf" ToolTip="File shelf" Content="&#xE8B7;" Foreground="#FFD60A" Click="Tab_Click" />
                                        <Button x:Name="TabNotes" Style="{StaticResource TabButton}" Tag="Notes" ToolTip="Notes" Content="&#xE70B;" Foreground="#F472B6" Click="Tab_Click" />
                                        <Button x:Name="TabSound" Style="{StaticResource TabButton}" Tag="Sound" ToolTip="Sound: outputs &amp; app volume" Content="&#xE7F5;" Foreground="#2DD4BF" Click="Tab_Click" />
                                        <Button x:Name="TabControls" Style="{StaticResource TabButton}" Tag="Controls" ToolTip="Quick controls" Content="&#xE9E9;" Foreground="#60A5FA" Click="Tab_Click" />
                                        <Button x:Name="TabTools" Style="{StaticResource TabButton}" Tag="Tools" ToolTip="Tools: calculator, color picker, countdown" Content="&#xE8EF;" Foreground="#A3E635" Click="Tab_Click" />
                                    </StackPanel>

                                    <StackPanel x:Name="HeaderRight" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel x:Name="ExpandedPrivacyDots" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Margin="0,0,6,0" Visibility="Collapsed">
                                            <Ellipse x:Name="ExpCamDot" Width="6" Height="6" Fill="#3DDC84" Margin="0,0,3,0" />
                                            <Ellipse x:Name="ExpMicDot" Width="6" Height="6" Fill="#FF9F0A" />
                                        </StackPanel>
                                        <TextBlock x:Name="ExpMicMuted" FontFamily="{StaticResource IconFont}" FontSize="11" Text="&#xE720;"
                                                   Foreground="#FF453A" VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"
                                                   ToolTip="Microphone muted (Win + Alt + M)" />
                                        <TextBlock x:Name="ExpandedTime" Style="{StaticResource NotchText}" FontSize="{DynamicResource FontSmall}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" Text="12:00 PM" />
                                    </StackPanel>

                                    <!-- Volume / pop-ups while the notch is open: replaces the header for a moment -->
                                    <StackPanel x:Name="HeaderToast" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center"
                                                VerticalAlignment="Center" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                                        <Border x:Name="HeaderToastIconBg" Width="20" Height="20" CornerRadius="10" Background="#7B6CFF" VerticalAlignment="Center">
                                            <TextBlock x:Name="HeaderToastIcon" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Text="&#xE995;" />
                                        </Border>
                                        <TextBlock x:Name="HeaderToastText" Style="{StaticResource NotchText}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" MaxWidth="230" TextTrimming="CharacterEllipsis" />
                                        <Grid x:Name="HeaderToastLevel" Width="72" Height="4" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <Border CornerRadius="2" Background="{DynamicResource TrackBrush}" />
                                            <Border CornerRadius="2" Background="{DynamicResource AccentBrush}" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="HeaderToastScale" ScaleX="0" ScaleY="1" />
                                                </Border.RenderTransform>
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="HeaderToastValue" Style="{StaticResource NotchText}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="PagesHost" Grid.Row="1" Margin="0,4,0,0" ClipToBounds="True">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="PagesShift" />
                                    </Grid.RenderTransform>

                                    <!-- ===== Music ===== -->
                                    <Grid x:Name="PageMusic">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid x:Name="TrackInfo" VerticalAlignment="Center" Background="Transparent"
                                              MouseLeftButtonUp="TrackInfo_MouseLeftButtonUp">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Grid x:Name="ArtContainer" Width="48" Height="48" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Border Style="{StaticResource ArtFrame}" CornerRadius="10" />
                                                <TextBlock x:Name="ArtPlaceholder" FontFamily="{StaticResource IconFont}" Text="&#xE8D6;" FontSize="19"
                                                           Foreground="{DynamicResource SubtleTextBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                                                <Border x:Name="ArtImage" CornerRadius="10" Visibility="Collapsed" IsHitTestVisible="False">
                                                    <Border.Background>
                                                        <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill" />
                                                    </Border.Background>
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <controls:MarqueeText x:Name="TitleText" Text="Not Playing"
                                                                      TextElement.Foreground="{DynamicResource TextBrush}"
                                                                      TextElement.FontFamily="{DynamicResource TextFont}"
                                                                      TextElement.FontSize="{DynamicResource FontLarge}"
                                                                      TextElement.FontWeight="SemiBold" />
                                                <TextBlock x:Name="ArtistText" Style="{StaticResource NotchText}"
                                                           Foreground="{DynamicResource SubtleTextBrush}"
                                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                                           Text="Play something to see it here" />
                                            </StackPanel>

                                            <StackPanel x:Name="ExpandedSpectrum" Grid.Column="2" Orientation="Horizontal"
                                                        VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
                                        </Grid>

                                        <Grid x:Name="ProgressRow" Grid.Row="1" Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="40" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="PositionText" Style="{StaticResource SubText}" VerticalAlignment="Center" Text="0:00" />
                                            <Grid x:Name="ProgressTrack" Grid.Column="1" Height="14" Background="Transparent" Cursor="Hand"
                                                  MouseLeftButtonDown="ProgressTrack_MouseLeftButtonDown">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource TrackBrush}" VerticalAlignment="Center" />
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                                        RenderTransformOrigin="0,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform x:Name="ProgressScale" ScaleX="0" ScaleY="1" />
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="DurationText" Grid.Column="2" Style="{StaticResource SubText}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" Text="0:00" />
                                        </Grid>

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Grid x:Name="VolumePanel" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="VolumePercent" Grid.Column="2" Style="{StaticResource SubText}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Margin="5,0,0,0" MinWidth="26" Text="50%" />
                                                <Button x:Name="VolumeButton" Style="{StaticResource MediaButton}" Width="30" Height="30" FontSize="14"
                                                        ToolTip="Mute / unmute" Click="VolumeButton_Click" Content="&#xE995;" />
                                                <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource NotchSlider}"
                                                        Minimum="0" Maximum="100" SmallChange="2" LargeChange="10" MaxWidth="80"
                                                        HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="4,0,0,0"
                                                        ValueChanged="VolumeSlider_ValueChanged" />
                                            </Grid>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button x:Name="ShuffleButton" Style="{StaticResource SmallMediaButton}" Margin="0,0,2,0"
                                                        ToolTip="Shuffle" Click="ShuffleButton_Click" Content="&#xE8B1;" />
                                                <Button x:Name="PreviousButton" Style="{StaticResource MediaButton}" Click="PreviousButton_Click" Content="&#xE892;" />
                                                <Button x:Name="PlayPauseButton" Style="{StaticResource MediaButton}" Width="38" Height="38" FontSize="19"
                                                        Margin="6,0,6,0" Click="PlayPauseButton_Click" Content="&#xE768;" />
                                                <Button x:Name="NextButton" Style="{StaticResource MediaButton}" Click="NextButton_Click" Content="&#xE893;" />
                                                <Button x:Name="RepeatModeButton" Style="{StaticResource SmallMediaButton}" Margin="2,0,0,0"
                                                        ToolTip="Repeat" Click="RepeatModeButton_Click" Content="&#xE8EE;" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button x:Name="OutputButton" Style="{StaticResource SmallMediaButton}" Foreground="#2DD4BF"
                                                        ToolTip="Sound output &amp; app volume" Click="OutputButton_Click" Content="&#xE7F5;" />
                                                <Button x:Name="SettingsButton" Style="{StaticResource SmallMediaButton}" Foreground="#A1A1AA"
                                                        ToolTip="Crest settings" Click="SettingsButton_Click" Content="&#xE713;" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>

                                    <!-- ===== Lyrics ===== -->
                                    <Grid x:Name="PageLyrics" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <DockPanel x:Name="LyricsFooter" Grid.Row="1" Margin="0,2,0,0">
                                            <StackPanel x:Name="LyricsSyncPanel" DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Style="{StaticResource TextButton}" Content="− 0.5 s" Tag="-500" Click="LyricsOffset_Click"
                                                        ToolTip="Lyrics are late: show them earlier" Margin="0,0,8,0" />
                                                <TextBlock x:Name="LyricsOffsetText" Style="{StaticResource SubText}" Text="in sync" Margin="0,0,8,0" />
                                                <Button Style="{StaticResource TextButton}" Content="+ 0.5 s" Tag="500" Click="LyricsOffset_Click"
                                                        ToolTip="Lyrics are early: show them later" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource SubText}" Opacity="0.7" Text="Lyrics by LRCLIB" />
                                        </DockPanel>
                                        <StackPanel x:Name="SyncedLyricsPanel" VerticalAlignment="Center" Visibility="Collapsed">
                                            <TextBlock x:Name="LyricPrev" Style="{StaticResource SubText}" TextAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <TextBlock.RenderTransform>
                                                    <TranslateTransform x:Name="LyricPrevShift" />
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBlock x:Name="LyricCurrent" Style="{StaticResource NotchText}" FontSize="{DynamicResource FontLarge}"
                                                       FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" MaxHeight="46" Margin="0,5,0,5">
                                                <TextBlock.RenderTransform>
                                                    <TranslateTransform x:Name="LyricShift" />
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                            <TextBlock x:Name="LyricNext" Style="{StaticResource SubText}" TextAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <TextBlock.RenderTransform>
                                                    <TranslateTransform x:Name="LyricNextShift" />
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                        </StackPanel>
                                        <ScrollViewer x:Name="PlainLyricsScroller" Visibility="Collapsed" Grid.Row="0"
                                                      VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                            <TextBlock x:Name="PlainLyricsText" Style="{StaticResource NotchText}" TextWrapping="Wrap" TextAlignment="Center" />
                                        </ScrollViewer>
                                        <TextBlock x:Name="LyricsStatus" Style="{StaticResource SubText}" TextAlignment="Center" TextWrapping="Wrap"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- ===== Calendar ===== -->
                                    <Grid x:Name="PageCalendar" Visibility="Collapsed">
                                        <StackPanel x:Name="CalendarList" VerticalAlignment="Top" />
                                        <TextBlock x:Name="CalendarStatus" Style="{StaticResource SubText}" TextAlignment="Center" TextWrapping="Wrap"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- ===== Weather ===== -->
                                    <Grid x:Name="PageWeather" Visibility="Collapsed">
                                        <Grid x:Name="WeatherContent" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="WeatherIcon" Style="{StaticResource NotchText}" FontFamily="Segoe UI Symbol" FontSize="34"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="WeatherTemp" Style="{StaticResource NotchText}" FontSize="28" FontWeight="SemiBold" />
                                                <TextBlock x:Name="WeatherDesc" Style="{StaticResource SubText}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="WeatherCityText" Style="{StaticResource SubText}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel x:Name="WeatherHours" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock x:Name="WeatherStatus" Style="{StaticResource SubText}" TextAlignment="Center" TextWrapping="Wrap"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- ===== System ===== -->
                                    <Grid x:Name="PageSystem" Visibility="Collapsed">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <UniformGrid Columns="2" Rows="2" VerticalAlignment="Center">
                                            <StackPanel Margin="0,0,12,10">
                                                <DockPanel>
                                                    <TextBlock x:Name="CpuText" DockPanel.Dock="Right" Style="{StaticResource NotchText}" FontSize="{DynamicResource FontSmall}" FontWeight="SemiBold" />
                                                    <TextBlock Style="{StaticResource SubText}" Text="CPU" />
                                                </DockPanel>
                                                <Grid Margin="0,4,0,0">
                                                    <Border Style="{StaticResource MeterTrack}" />
                                                    <Border Style="{StaticResource MeterFill}">
                                                        <Border.RenderTransform><ScaleTransform x:Name="CpuScale" ScaleX="0" /></Border.RenderTransform>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Margin="12,0,0,10">
                                                <DockPanel>
                                                    <TextBlock x:Name="RamText" DockPanel.Dock="Right" Style="{StaticResource NotchText}" FontSize="{DynamicResource FontSmall}" FontWeight="SemiBold" />
                                                    <TextBlock Style="{StaticResource SubText}" Text="Memory" />
                                                </DockPanel>
                                                <Grid Margin="0,4,0,0">
                                                    <Border Style="{StaticResource MeterTrack}" />
                                                    <Border Style="{StaticResource MeterFill}">
                                                        <Border.RenderTransform><ScaleTransform x:Name="RamScale" ScaleX="0" /></Border.RenderTransform>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,0">
                                                <DockPanel>
                                                    <TextBlock x:Name="GpuText" DockPanel.Dock="Right" Style="{StaticResource NotchText}" FontSize="{DynamicResource FontSmall}" FontWeight="SemiBold" />
                                                    <TextBlock Style="{StaticResource SubText}" Text="GPU" />
                                                </DockPanel>
                                                <Grid Margin="0,4,0,0">
                                                    <Border Style="{StaticResource MeterTrack}" />
                                                    <Border Style="{StaticResource MeterFill}">
                                                        <Border.RenderTransform><ScaleTransform x:Name="GpuScale" ScaleX="0" /></Border.RenderTransform>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Margin="12,0,0,0">
                                                <DockPanel>
                                                    <TextBlock x:Name="DiskText" DockPanel.Dock="Right" Style="{StaticResource NotchText}" FontSize="{DynamicResource FontSmall}" FontWeight="SemiBold" />
                                                    <TextBlock Style="{StaticResource SubText}" Text="Disk" />
                                                </DockPanel>
                                                <Grid Margin="0,4,0,0">
                                                    <Border Style="{StaticResource MeterTrack}" />
                                                    <Border Style="{StaticResource MeterFill}">
                                                        <Border.RenderTransform><ScaleTransform x:Name="DiskScale" ScaleX="0" /></Border.RenderTransform>
                                                    </Border>
                                                </Grid>
                                            </StackPanel>
                                        </UniformGrid>
                                        <StackPanel Grid.Row="1">
                                            <TextBlock x:Name="DevicesFooter" Style="{StaticResource SubText}" TextTrimming="CharacterEllipsis"
                                                       Visibility="Collapsed" Margin="0,0,0,1" />
                                            <TextBlock x:Name="SystemFooter" Style="{StaticResource SubText}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- ===== Timer ===== -->
                                    <Grid x:Name="PageTimer" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="ModeTimerBtn" Style="{StaticResource ChipButton}" Content="Timer" Click="TimerMode_Click" Tag="Timer" />
                                                <Button x:Name="ModeStopwatchBtn" Style="{StaticResource ChipButton}" Content="Stopwatch" Click="TimerMode_Click" Tag="Stopwatch" />
                                                <Button x:Name="ModeFocusBtn" Style="{StaticResource ChipButton}" Content="Focus" Click="TimerMode_Click" Tag="Focus" />
                                            </StackPanel>
                                            <TextBlock x:Name="TimerBig" Style="{StaticResource NotchText}" FontFamily="Segoe UI Variable Display, Segoe UI"
                                                       FontSize="34" FontWeight="SemiBold" Text="05:00" Margin="0,2,0,0" />
                                            <TextBlock x:Name="TimerSub" Style="{StaticResource SubText}" FontWeight="SemiBold" Visibility="Collapsed" Text="Focus · round 1" />
                                            <TextBlock x:Name="FocusStatsText" Style="{StaticResource SubText}" Visibility="Collapsed" Margin="0,1,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <WrapPanel x:Name="TimerPresets" Width="150" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource ChipButton}" Content="1 min" Tag="1" Click="TimerPreset_Click" />
                                                <Button Style="{StaticResource ChipButton}" Content="5 min" Tag="5" Click="TimerPreset_Click" />
                                                <Button Style="{StaticResource ChipButton}" Content="10 min" Tag="10" Click="TimerPreset_Click" />
                                                <Button Style="{StaticResource ChipButton}" Content="25 min" Tag="25" Click="TimerPreset_Click" />
                                            </WrapPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button x:Name="TimerPlusBtn" Style="{StaticResource MediaButton}" FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                                        ToolTip="Add a minute" Content="+1" Click="TimerPlus_Click" />
                                                <Button x:Name="TimerResetBtn" Style="{StaticResource MediaButton}" FontSize="13" ToolTip="Reset"
                                                        Content="&#xE72C;" Click="TimerReset_Click" />
                                                <Button x:Name="TimerToggleBtn" Style="{StaticResource MediaButton}" Width="38" Height="38" FontSize="18"
                                                        ToolTip="Start / pause" Content="&#xE768;" Click="TimerToggle_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- ===== Shelf ===== -->
                                    <Grid x:Name="PageShelf" Visibility="Collapsed" Background="Transparent">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Rectangle x:Name="ShelfDropHint" RadiusX="12" RadiusY="12" Stroke="{DynamicResource TrackBrush}"
                                                   StrokeThickness="1.5" StrokeDashArray="4 3" IsHitTestVisible="False" />
                                        <ScrollViewer x:Name="ShelfScroller" Margin="6,4"
                                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                                      PreviewMouseWheel="ShelfScroller_PreviewMouseWheel">
                                            <StackPanel x:Name="ShelfPanel" Orientation="Horizontal" VerticalAlignment="Center" />
                                        </ScrollViewer>
                                        <TextBlock x:Name="ShelfEmpty" Style="{StaticResource SubText}" TextAlignment="Center" TextWrapping="Wrap"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0"
                                                   Text="Drag files onto the notch to keep them handy, then drag them out wherever you need them." />
                                        <DockPanel Grid.Row="1" Margin="2,3,2,0">
                                            <Button x:Name="ShelfClearBtn" DockPanel.Dock="Right" Style="{StaticResource TextButton}" Content="Clear all" Click="ShelfClear_Click" />
                                            <TextBlock x:Name="ShelfCount" Style="{StaticResource SubText}" />
                                        </DockPanel>
                                    </Grid>

                                    <!-- ===== Notes ===== -->
                                    <Grid x:Name="PageNotes" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,1">
                                                <Button x:Name="NotesModeNote" Style="{StaticResource ChipButton}" Content="Note" Tag="Note" Click="NotesMode_Click" />
                                                <Button x:Name="NotesModeTodo" Style="{StaticResource ChipButton}" Content="To-do" Tag="Todo" Click="NotesMode_Click" />
                                                <TextBlock x:Name="TodoCount" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="4,0,0,5" />
                                            </StackPanel>
                                            <Grid>
                                        <Border x:Name="NotePanel" CornerRadius="10" Background="{DynamicResource HoverBrush}" Padding="8,6">
                                            <Grid>
                                                <TextBlock x:Name="NotesPlaceholder" Style="{StaticResource SubText}" Text="Quick note…" Margin="2,1,0,0" />
                                                <TextBox x:Name="NotesBox" Background="Transparent" BorderThickness="0"
                                                         Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                                         FontFamily="{DynamicResource TextFont}" FontSize="{DynamicResource FontBase}"
                                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Hidden"
                                                         PreviewMouseLeftButtonDown="NotesBox_PreviewMouseLeftButtonDown"
                                                         PreviewKeyDown="NotesBox_PreviewKeyDown"
                                                         TextChanged="NotesBox_TextChanged" />
                                            </Grid>
                                        </Border>
                                        <DockPanel x:Name="TodoPanel" Visibility="Collapsed">
                                            <Border DockPanel.Dock="Top" CornerRadius="8" Background="{DynamicResource HoverBrush}" Padding="8,3" Margin="0,0,0,4">
                                                <Grid>
                                                    <TextBlock x:Name="TodoPlaceholder" Style="{StaticResource SubText}" Text="Add a task, press Enter…" Margin="2,1,0,0" />
                                                    <TextBox x:Name="TodoBox" Background="Transparent" BorderThickness="0"
                                                             Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                                             FontFamily="{DynamicResource TextFont}" FontSize="{DynamicResource FontSmall}"
                                                             PreviewMouseLeftButtonDown="TypingBox_PreviewMouseLeftButtonDown"
                                                             PreviewKeyDown="TodoBox_PreviewKeyDown" TextChanged="TodoBox_TextChanged" />
                                                </Grid>
                                            </Border>
                                            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel x:Name="TodoList" />
                                            </ScrollViewer>
                                        </DockPanel>
                                            </Grid>
                                        </DockPanel>
                                        <StackPanel x:Name="ClipboardPanel" Grid.Column="1" Width="140" Margin="10,0,0,0" Visibility="Collapsed">
                                            <TextBlock Style="{StaticResource SubText}" FontWeight="SemiBold" Text="RECENT COPIES" Margin="2,0,0,4" />
                                            <StackPanel x:Name="ClipboardList" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- ===== Sound: output device + per-app volume ===== -->
                                    <Grid x:Name="PageSound" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="5*" />
                                            <ColumnDefinition Width="6*" />
                                        </Grid.ColumnDefinitions>
                                        <DockPanel Margin="0,0,10,0">
                                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SubText}" FontWeight="SemiBold" Text="OUTPUT" Margin="2,0,0,4" />
                                            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel x:Name="OutputList" />
                                            </ScrollViewer>
                                        </DockPanel>
                                        <DockPanel Grid.Column="1">
                                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SubText}" FontWeight="SemiBold" Text="APPS" Margin="2,0,0,4" />
                                            <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel x:Name="MixerList" />
                                            </ScrollViewer>
                                        </DockPanel>
                                    </Grid>

                                    <!-- ===== Tools: calculator · color picker · countdown ===== -->
                                    <Grid x:Name="PageTools" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <Border CornerRadius="10" Background="{DynamicResource HoverBrush}" Padding="9,6">
                                                <Grid>
                                                    <TextBlock x:Name="CalcPlaceholder" Style="{StaticResource SubText}" Text="12*7+5   ·   5 km in miles" Margin="2,1,0,0" />
                                                    <TextBox x:Name="CalcBox" Background="Transparent" BorderThickness="0"
                                                             Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                                             FontFamily="{DynamicResource TextFont}" FontSize="{DynamicResource FontBase}"
                                                             PreviewMouseLeftButtonDown="TypingBox_PreviewMouseLeftButtonDown"
                                                             PreviewKeyDown="CalcBox_PreviewKeyDown" TextChanged="CalcBox_TextChanged" />
                                                </Grid>
                                            </Border>
                                            <TextBlock x:Name="CalcResult" Style="{StaticResource NotchText}" FontFamily="Segoe UI Variable Display, Segoe UI"
                                                       FontSize="26" FontWeight="SemiBold" Margin="2,6,0,0" TextTrimming="CharacterEllipsis" Text="=" />
                                            <TextBlock x:Name="CalcHint" Style="{StaticResource SubText}" Margin="2,0,0,0" Text="Type a sum or a conversion. Enter copies the answer." />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="PickColorButton" Style="{StaticResource ChipButton}" Content="Pick a color" Click="PickColor_Click"
                                                        ToolTip="Click, then click anywhere on screen. The color code is copied." />
                                            </StackPanel>
                                            <StackPanel x:Name="ColorHistory" Orientation="Horizontal" Margin="0,0,0,6" />
                                            <TextBlock x:Name="CountdownBig" Style="{StaticResource NotchText}" FontWeight="SemiBold" FontSize="{DynamicResource FontLarge}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="CountdownSub" Style="{StaticResource SubText}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- ===== Controls: quick toggles ===== -->
                                    <UniformGrid x:Name="PageControls" Visibility="Collapsed" Columns="4" Rows="2" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Mirrored right shoulder -->
            <Path x:Name="RightShoulder"
                  VerticalAlignment="Top" Width="10" Height="10" Stretch="Fill"
                  Fill="{DynamicResource NotchBackground}"
                  Data="M0,0 L10,0 L10,10 A10,10 0 0 0 0,0 Z"
                  RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                <Path.RenderTransform>
                    <ScaleTransform ScaleX="-1" />
                </Path.RenderTransform>
            </Path>

            <!-- ======================= BUBBLE (timer / stopwatch next to the notch) ======================= -->
            <Border x:Name="Bubble" Width="0" Height="36" Margin="8,0,0,0" VerticalAlignment="Top" Visibility="Collapsed"
                    Background="{DynamicResource NotchBackground}" CornerRadius="0,0,14,14" ClipToBounds="True" Cursor="Hand"
                    ToolTip="Open the timer" MouseLeftButtonUp="Bubble_MouseLeftButtonUp">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="BubbleIcon" FontFamily="{StaticResource IconFont}" FontSize="12" Text="&#xE916;"
                               Foreground="#FF9F0A" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBlock x:Name="BubbleText" Style="{StaticResource NotchText}" FontWeight="SemiBold" Margin="6,0,0,0"
                               VerticalAlignment="Center" Text="05:00" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
