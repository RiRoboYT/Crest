<Window x:Class="Crest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Crest"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Left="0" Top="0" Width="480" Height="220">

    <!--
        The window itself is a fixed, fully transparent rectangle big enough for the expanded notch.
        Transparent pixels are click-through, so only the black shape receives the mouse.
        All colors / sizes below are placeholders; MainWindow.ApplySettings() overwrites them.
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="NotchBackground" Color="Black" />
        <SolidColorBrush x:Key="TextBrush" Color="White" />
        <SolidColorBrush x:Key="SubtleTextBrush" Color="#99FFFFFF" />
        <SolidColorBrush x:Key="TrackBrush" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="White" />
        <SolidColorBrush x:Key="HoverBrush" Color="#22FFFFFF" />
        <FontFamily x:Key="TextFont">Segoe UI</FontFamily>
        <sys:Double x:Key="FontBase">13</sys:Double>
        <sys:Double x:Key="FontLarge">15</sys:Double>
        <sys:Double x:Key="FontSmall">11</sys:Double>

        <Style x:Key="MediaButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="999"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NotchText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource TextFont}" />
            <Setter Property="FontSize" Value="{DynamicResource FontBase}" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" HorizontalAlignment="Center" VerticalAlignment="Top">
        <StackPanel x:Name="ShapeRow" Orientation="Horizontal" VerticalAlignment="Top">

            <!-- Concave "shoulder" that blends the notch into the top screen edge (Notch shape only) -->
            <Path x:Name="LeftShoulder"
                  VerticalAlignment="Top"
                  Width="10" Height="10"
                  Stretch="Fill"
                  Fill="{DynamicResource NotchBackground}"
                  Data="M0,0 L10,0 L10,10 A10,10 0 0 0 0,0 Z"
                  IsHitTestVisible="False" />

            <Border x:Name="Notch"
                    VerticalAlignment="Top"
                    Width="220" Height="36"
                    CornerRadius="0,0,14,14"
                    Background="{DynamicResource NotchBackground}"
                    MouseEnter="Notch_MouseEnter"
                    MouseLeave="Notch_MouseLeave"
                    MouseLeftButtonUp="Notch_MouseLeftButtonUp"
                    MouseRightButtonUp="Notch_MouseRightButtonUp"
                    MouseWheel="Notch_MouseWheel">

                <Grid x:Name="ContentRoot" ClipToBounds="True">

                    <!-- ======================= COLLAPSED ======================= -->
                    <Grid x:Name="CollapsedHost"
                          HorizontalAlignment="Center" VerticalAlignment="Top"
                          Width="220" Height="36">
                        <Grid Margin="16,0,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="CollapsedTime"
                                       Style="{StaticResource NotchText}"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="12:00 PM" />

                            <StackPanel x:Name="CollapsedSpectrum"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0"
                                        IsHitTestVisible="False" />
                        </Grid>
                    </Grid>

                    <!-- ======================= EXPANDED ======================= -->
                    <Grid x:Name="ExpandedHost"
                          HorizontalAlignment="Center" VerticalAlignment="Top"
                          Width="400" Height="170"
                          Opacity="0" Visibility="Collapsed">
                        <Grid Margin="22,10,22,12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />   <!-- date / time -->
                                <RowDefinition Height="*" />      <!-- art + title -->
                                <RowDefinition Height="Auto" />   <!-- progress -->
                                <RowDefinition Height="Auto" />   <!-- controls -->
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0">
                                <TextBlock x:Name="DateText"
                                           Style="{StaticResource NotchText}"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           FontSize="{DynamicResource FontSmall}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Text="Thursday, Nov 6" />
                                <TextBlock x:Name="ExpandedTime"
                                           Style="{StaticResource NotchText}"
                                           FontSize="{DynamicResource FontSmall}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Text="12:00 PM" />
                            </Grid>

                            <!-- Track info -->
                            <Grid Grid.Row="1" Margin="0,8,0,6" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid x:Name="ArtContainer" Width="52" Height="52" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Border CornerRadius="10" Background="{DynamicResource TrackBrush}" />
                                    <TextBlock x:Name="ArtPlaceholder"
                                               FontFamily="{StaticResource IconFont}"
                                               Text="&#xE8D6;" FontSize="20"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsHitTestVisible="False" />
                                    <Border x:Name="ArtImage" CornerRadius="10" Visibility="Collapsed">
                                        <Border.Background>
                                            <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TitleText"
                                               Style="{StaticResource NotchText}"
                                               FontSize="{DynamicResource FontLarge}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Text="Not Playing" />
                                    <TextBlock x:Name="ArtistText"
                                               Style="{StaticResource NotchText}"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               FontSize="{DynamicResource FontBase}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,1,0,0"
                                               Text="Play something to see it here" />
                                </StackPanel>

                                <StackPanel x:Name="ExpandedSpectrum"
                                            Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0"
                                            IsHitTestVisible="False" />
                            </Grid>

                            <!-- Progress -->
                            <Grid x:Name="ProgressRow" Grid.Row="2" Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="PositionText"
                                           Style="{StaticResource NotchText}"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           FontSize="{DynamicResource FontSmall}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"
                                           Text="0:00" />

                                <!-- Taller transparent hit area so the thin bar is easy to click -->
                                <Grid x:Name="ProgressTrack"
                                      Grid.Column="1"
                                      Height="14"
                                      Background="Transparent"
                                      Cursor="Hand"
                                      MouseLeftButtonDown="ProgressTrack_MouseLeftButtonDown">
                                    <Border Height="4" CornerRadius="2" Background="{DynamicResource TrackBrush}" VerticalAlignment="Center" />
                                    <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                            RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="ProgressScale" ScaleX="0" ScaleY="1" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>

                                <TextBlock x:Name="DurationText"
                                           Grid.Column="2"
                                           Style="{StaticResource NotchText}"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           FontSize="{DynamicResource FontSmall}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                           Text="0:00" />
                            </Grid>

                            <!-- Controls -->
                            <Grid Grid.Row="3">
                                <Button x:Name="VolumeButton"
                                        Style="{StaticResource MediaButton}"
                                        HorizontalAlignment="Left"
                                        FontSize="14"
                                        ToolTip="Mute / unmute (scroll on the notch to change volume)"
                                        Click="VolumeButton_Click"
                                        Content="&#xE767;" />

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button x:Name="PreviousButton"
                                            Style="{StaticResource MediaButton}"
                                            Click="PreviousButton_Click"
                                            Content="&#xE892;" />
                                    <Button x:Name="PlayPauseButton"
                                            Style="{StaticResource MediaButton}"
                                            Width="40" Height="40" FontSize="20"
                                            Margin="10,0,10,0"
                                            Click="PlayPauseButton_Click"
                                            Content="&#xE768;" />
                                    <Button x:Name="NextButton"
                                            Style="{StaticResource MediaButton}"
                                            Click="NextButton_Click"
                                            Content="&#xE893;" />
                                </StackPanel>

                                <Button x:Name="SettingsButton"
                                        Style="{StaticResource MediaButton}"
                                        HorizontalAlignment="Right"
                                        FontSize="13"
                                        ToolTip="Crest settings"
                                        Click="SettingsButton_Click"
                                        Content="&#xE713;" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Mirrored right shoulder -->
            <Path x:Name="RightShoulder"
                  VerticalAlignment="Top"
                  Width="10" Height="10"
                  Stretch="Fill"
                  Fill="{DynamicResource NotchBackground}"
                  Data="M0,0 L10,0 L10,10 A10,10 0 0 0 0,0 Z"
                  RenderTransformOrigin="0.5,0.5"
                  IsHitTestVisible="False">
                <Path.RenderTransform>
                    <ScaleTransform ScaleX="-1" />
                </Path.RenderTransform>
            </Path>
        </StackPanel>
    </Grid>
</Window>
