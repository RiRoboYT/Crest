<Window x:Class="Crest.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crest Settings"
        Width="560" Height="760"
        MinWidth="460" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#FAFAFA"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- DataContext = AppSettings. Every control is two-way bound, so changes apply live. -->
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1A1A1A" />
            <Setter Property="Margin" Value="0,20,0,6" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Width" Value="200" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#333" />
            <Setter Property="DockPanel.Dock" Value="Left" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Width" Value="52" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="DockPanel.Dock" Value="Right" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,4" />
        </Style>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="LastChildFill" Value="True" />
        </Style>
        <Style TargetType="Slider">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Pick a color" />
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#AAA" BorderThickness="1" CornerRadius="4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HexBox" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
        <Style x:Key="FooterButton" TargetType="Button">
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ====================== Footer ====================== -->
        <Border DockPanel.Dock="Bottom" Background="#F0F0F0" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <CheckBox x:Name="PreviewCheck"
                          DockPanel.Dock="Left"
                          Content="Preview expanded"
                          VerticalAlignment="Center"
                          Checked="PreviewCheck_Changed"
                          Unchecked="PreviewCheck_Changed" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource FooterButton}" Content="Reset to defaults" Click="Reset_Click" />
                    <Button Style="{StaticResource FooterButton}" Content="Close" IsCancel="True" IsDefault="False" Click="Close_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="22,4,22,20">

                <!-- ====================== Size ====================== -->
                <TextBlock Style="{StaticResource Section}" Text="Size" />

                <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource Label}" Text="Collapsed width (px)" />
                    <TextBlock Style="{StaticResource Value}" Text="{Binding CollapsedWidth, StringFormat=0}" />
                    <Slider Minimum="80" Maximum="600" Value="{Binding CollapsedWidth}" SmallChange="1" LargeChange="10" />
                </DockPanel>
                <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource Label}" Text="Collapsed height (px)" />
                    <TextBlock Style="{StaticResource Value}" Text="{Binding CollapsedHeight, StringFormat=0}" />
                    <Slider Minimum="20" Maximum="80" Value="{Binding CollapsedHeight}" SmallChange="1" LargeChange="4" />
                </DockPanel>
                <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource Label}" Text="Expanded width (px)" />
                    <TextBlock Style="{StaticResource Value}" Text="{Binding ExpandedWidth, StringFormat=0}" />
                    <Slider Minimum="260" Maximum="800" Value="{Binding ExpandedWidth}" SmallChange="1" LargeChange="10" />
                </DockPanel>
                <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource Label}" Text="Expanded height (px)" />
                    <TextBlock Style="{StaticResource Value}" Text="{Binding ExpandedHeight, StringFormat=0}" />
                    <Slider Minimum="120" Maximum="320" Value="{Binding ExpandedHeight}" SmallChange="1" LargeChange="10" />
                </DockPanel>
                <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource Label}" Text="Corner radius (px)" />
                    <TextBlock Style="{StaticResource Value}" Text="{Binding CornerRadius, StringFormat=0}" />
                    <Slider Minimum="0" Maximum="40" Value="{Binding CornerRadius}" SmallChange="1" LargeChange="2" />
                </DockPanel>
                <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource Label}" Text="Expanded corner radius (px)" />
                    <TextBlock Style="{StaticResource Value}" Text="{Binding ExpandedCornerRadius, StringFormat=0}" />
                    <Slider Minimum="0" Maximum="60" Value="{Binding ExpandedCornerRadius}" SmallChange="1" LargeChange="2" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Text="Tick &quot;Preview expanded&quot; below to keep the player open while you adjust it." />

                <!-- ====================== Shape & position ====================== -->
                <TextBlock Style="{StaticResource Section}" Text="Shape &amp; position" />

                <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource Label}" Text="Shape" />
                    <ComboBox x:Name="ShapeCombo" Width="160" HorizontalAlignment="Left" SelectedItem="{Binding Shape}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource Label}" Text="Shoulder curve (notch, px)" />
                    <TextBlock Style="{StaticResource Value}" Text="{Binding ShoulderSize, StringFormat=0}" />
                    <Slider Minimum="0" Maximum="24" Value="{Binding ShoulderSize}" SmallChange="1" LargeChange="2" />
                </DockPanel>
                <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource Label}" Text="Top margin (pill, px)" />
                    <TextBlock Style="{StaticResource Value}" Text="{Binding TopMargin, StringFormat=0}" />
                    <Slider Minimum="0" Maximum="40" Value="{Binding TopMargin}" SmallChange="1" LargeChange="2" />
                </DockPanel>
                <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource Label}" Text="Horizontal offset (px)" />
                    <TextBlock Style="{StaticResource Value}" Text="{Binding HorizontalOffset, StringFormat=0}" />
                    <Button DockPanel.Dock="Right" Content="Center" Padding="8,1" Margin="0,0,8,0" Click="CenterOffset_Click" />
                    <Slider Minimum="-1200" Maximum="1200" Value="{Binding HorizontalOffset}" SmallChange="1" LargeChange="20" />
                </DockPanel>

                <!-- ====================== Appearance ====================== -->
                <TextBlock Style="{StaticResource Section}" Text="Appearance" />

                <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource Label}" Text="Background color" />
                    <Button Style="{StaticResource Swatch}" Tag="BackgroundColor" Click="PickColor_Click"
                            Background="{Binding BackgroundColor, Converter={StaticResource HexToBrush}}" />
                    <TextBox Style="{StaticResource HexBox}" Text="{Binding BackgroundColor, UpdateSourceTrigger=LostFocus}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource Label}" Text="Background opacity" />
                    <TextBlock Style="{StaticResource Value}" Text="{Binding BackgroundOpacity, StringFormat=P0}" />
                    <Slider Minimum="0.1" Maximum="1" Value="{Binding BackgroundOpacity}" SmallChange="0.01" LargeChange="0.1" />
                </DockPanel>
                <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource Label}" Text="Text color" />
                    <Button Style="{StaticResource Swatch}" Tag="TextColor" Click="PickColor_Click"
                            Background="{Binding TextColor, Converter={StaticResource HexToBrush}}" />
                    <TextBox Style="{StaticResource HexBox}" Text="{Binding TextColor, UpdateSourceTrigger=LostFocus}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource Label}" Text="Progress bar color" />
                    <Button Style="{StaticResource Swatch}" Tag="AccentColor" Click="PickColor_Click"
                            Background="{Binding AccentColor, Converter={StaticResource HexToBrush}}" />
                    <TextBox Style="{StaticResource HexBox}" Text="{Binding AccentColor, UpdateSourceTrigger=LostFocus}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource Label}" Text="Font" />
                    <ComboBox x:Name="FontCombo"
                              IsEditable="True"
                              IsTextSearchEnabled="True"
                              Text="{Binding FontFamily, UpdateSourceTrigger=PropertyChanged, Delay=300}">
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>
                </DockPanel>
                <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource Label}" Text="Font size (pt)" />
                    <TextBlock Style="{StaticResource Value}" Text="{Binding FontSize, StringFormat=0.#}" />
                    <Slider Minimum="8" Maximum="24" Value="{Binding FontSize}" SmallChange="0.5" LargeChange="1"
                            TickFrequency="0.5" IsSnapToTickEnabled="True" />
                </DockPanel>
                <CheckBox Content="24-hour clock" IsChecked="{Binding Use24HourClock}" />
                <CheckBox Content="Show seconds" IsChecked="{Binding ShowSeconds}" />

                <!-- ====================== Spectrum ====================== -->
                <TextBlock Style="{StaticResource Section}" Text="Spectrum" />

                <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource Label}" Text="Number of bars" />
                    <TextBlock Style="{StaticResource Value}" Text="{Binding SpectrumBarCount}" />
                    <Slider Minimum="3" Maximum="12" Value="{Binding SpectrumBarCount}" TickFrequency="1" IsSnapToTickEnabled="True" />
                </DockPanel>
                <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource Label}" Text="Bar color" />
                    <Button Style="{StaticResource Swatch}" Tag="SpectrumColor" Click="PickColor_Click"
                            Background="{Binding SpectrumColor, Converter={StaticResource HexToBrush}}" />
                    <TextBox Style="{StaticResource HexBox}" Text="{Binding SpectrumColor, UpdateSourceTrigger=LostFocus}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource Label}" Text="Update interval (ms)" />
                    <TextBlock Style="{StaticResource Value}" Text="{Binding SpectrumSpeedMs, StringFormat=0}" />
                    <Slider Minimum="40" Maximum="300" Value="{Binding SpectrumSpeedMs}" TickFrequency="5" IsSnapToTickEnabled="True" />
                </DockPanel>
                <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource Label}" Text="Bar thickness (px)" />
                    <TextBlock Style="{StaticResource Value}" Text="{Binding SpectrumBarWidth, StringFormat=0.#}" />
                    <Slider Minimum="1" Maximum="8" Value="{Binding SpectrumBarWidth}" TickFrequency="0.5" IsSnapToTickEnabled="True" />
                </DockPanel>
                <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource Label}" Text="Bar spacing (px)" />
                    <TextBlock Style="{StaticResource Value}" Text="{Binding SpectrumBarSpacing, StringFormat=0.#}" />
                    <Slider Minimum="0" Maximum="8" Value="{Binding SpectrumBarSpacing}" TickFrequency="0.5" IsSnapToTickEnabled="True" />
                </DockPanel>
                <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource Label}" Text="Max bar height (px)" />
                    <TextBlock Style="{StaticResource Value}" Text="{Binding SpectrumMaxHeight, StringFormat=0}" />
                    <Slider Minimum="6" Maximum="40" Value="{Binding SpectrumMaxHeight}" TickFrequency="1" IsSnapToTickEnabled="True" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Text="The bars are a lightweight fake animation – they only move while something is playing." />

                <!-- ====================== Behavior ====================== -->
                <TextBlock Style="{StaticResource Section}" Text="Behavior" />

                <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" />
                <CheckBox Content="Always on top (stays over fullscreen apps)" IsChecked="{Binding AlwaysOnTop}" />
                <CheckBox Content="Expand on hover (otherwise click to expand)" IsChecked="{Binding ExpandOnHover}" />
                <CheckBox Content="Scroll on the notch changes system volume" IsChecked="{Binding ScrollChangesVolume}" />
                <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource Label}" Text="Animation duration (ms)" />
                    <TextBlock Style="{StaticResource Value}" Text="{Binding AnimationDurationMs, StringFormat=0}" />
                    <Slider Minimum="0" Maximum="600" Value="{Binding AnimationDurationMs}" TickFrequency="10" IsSnapToTickEnabled="True" />
                </DockPanel>
                <DockPanel Style="{StaticResource Row}">
                    <TextBlock Style="{StaticResource Label}" Text="Collapse delay (ms)" />
                    <TextBlock Style="{StaticResource Value}" Text="{Binding CollapseDelayMs, StringFormat=0}" />
                    <Slider Minimum="0" Maximum="1000" Value="{Binding CollapseDelayMs}" TickFrequency="10" IsSnapToTickEnabled="True" />
                </DockPanel>

                <!-- ====================== Display ====================== -->
                <TextBlock Style="{StaticResource Section}" Text="Expanded view" />

                <CheckBox Content="Show date" IsChecked="{Binding ShowDate}" />
                <CheckBox Content="Show album art" IsChecked="{Binding ShowAlbumArt}" />
                <CheckBox Content="Show progress bar" IsChecked="{Binding ShowProgress}" />
                <CheckBox Content="Show volume button" IsChecked="{Binding ShowVolumeIcon}" />
                <CheckBox Content="Show spectrum next to the song title" IsChecked="{Binding ShowSpectrumWhenExpanded}" />

                <!-- ====================== About ====================== -->
                <TextBlock Style="{StaticResource Section}" Text="Settings file" />
                <TextBlock Style="{StaticResource Hint}">
                    <Hyperlink x:Name="SettingsPathLink" Click="SettingsPathLink_Click">
                        <Run x:Name="SettingsPathRun" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock Style="{StaticResource Hint}" Text="Changes are saved automatically. Right-click the notch or use the tray icon to reopen this window." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
