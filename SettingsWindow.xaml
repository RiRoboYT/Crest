                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Clipboard" Margin="0,0,0,4" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ClipboardHistory}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Recent copies on the Notes page" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Remembers the last few texts you copied – in memory only, cleared when Crest closes. Off by default because copied passwords would show up too." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}" IsEnabled="{Binding ClipboardHistory}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ClipboardImages}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Images too" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Copied pictures and screenshots show up as small previews (the newest 3, memory only)." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <TextBlock Style="{StaticResource RowDesc}" TextWrapping="Wrap" Margin="0,10,0,6" Text="Right-click a copied text in the notch to pin it (signature, address, links). Pinned texts stay at the top and are remembered after a restart." />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ======================= BEHAVIOR ======================= -->
                            <StackPanel x:Name="PageBehavior" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="General" Margin="0,0,0,4" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Start with Windows" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Launch Crest automatically when you sign in." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding AlwaysOnTop}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Always on top" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Stays above fullscreen videos and borderless games." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding HideWhileTyping}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Hide while typing" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="The notch shrinks to a thin line while you type and comes back a moment after you stop. Only notices that a key was pressed – nothing you type is read or saved." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding TrimMemory}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Free up memory while idle" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="When Crest has been sitting closed with nothing playing, it hands unused memory back to Windows." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ScrollChangesVolume}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Scroll on the notch changes volume" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Mouse wheel up / down over the notch." />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Hover &amp; animation" Margin="0,0,0,4" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ExpandOnHover}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Open on hover" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Off = click the notch to open it." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <StackPanel Style="{StaticResource SliderRow}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource ValuePill}">
                                                    <TextBlock Style="{StaticResource ValueText}"><Run Text="{Binding HoverDelayMs, Mode=OneWay}" /><Run Text=" ms" /></TextBlock>
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource RowTitle}" Text="Hover delay" />
                                                    <TextBlock Style="{StaticResource RowDesc}" Text="How long the mouse must rest on the notch before it opens." />
                                                </StackPanel>
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="800" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,6,0,0"
                                                    Value="{Binding HoverDelayMs}" IsEnabled="{Binding ExpandOnHover}" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource SliderRow}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource ValuePill}">
                                                    <TextBlock Style="{StaticResource ValueText}"><Run Text="{Binding CollapseDelayMs, Mode=OneWay}" /><Run Text=" ms" /></TextBlock>
                                                </Border>
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Close delay" />
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="1000" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,6,0,0" Value="{Binding CollapseDelayMs}" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource SliderRow}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource ValuePill}">
                                                    <TextBlock Style="{StaticResource ValueText}"><Run Text="{Binding AnimationDurationMs, Mode=OneWay}" /><Run Text=" ms" /></TextBlock>
                                                </Border>
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Animation duration" />
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="600" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,6,0,0" Value="{Binding AnimationDurationMs}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Gestures" Margin="0,0,0,4" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ScrollSkipsTracks}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Swipe sideways to skip songs" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Touchpad swipe, tilt wheel or Shift + scroll on the closed notch. On the open notch it switches pages." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding DoubleClickPlayPause}" />
                                            <TextBlock Style="{StaticResource RowTitle}" Text="Double-click to play / pause" />
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding MiddleClickMute}" />
                                            <TextBlock Style="{StaticResource RowTitle}" Text="Middle-click to mute" />
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding HotkeyEnabled}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Win + Alt + N opens the notch" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Press again to close it." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding KeyboardControl}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Keyboard control after Win + Alt + N" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="← → switch pages, ↑ ↓ change the volume, Space plays or pauses, Ctrl + ← → skip songs, M mutes, Esc closes." />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Per-app rules" Margin="0,0,0,4" />
                                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,10"
                                                   Text="While one of these apps is in front, Crest hides completely or just stays quiet (no peeks or pop-ups)." />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid>
                                                <TextBox x:Name="RuleAppBox" />
                                                <TextBlock x:Name="RuleAppPlaceholder" Text="App name, e.g. valorant or obs64" IsHitTestVisible="False"
                                                           Foreground="{DynamicResource S.Faint}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                                            </Grid>
                                            <ComboBox x:Name="RuleActionCombo" Grid.Column="1" Width="150" MinWidth="150" Margin="8,0,0,0" SelectedIndex="0">
                                                <ComboBoxItem Content="No pop-ups" />
                                                <ComboBoxItem Content="Hide the notch" />
                                            </ComboBox>
                                            <Button Grid.Column="2" Style="{StaticResource AccentButton}" Content="Add" Margin="8,0,0,0" Padding="18,7"
                                                    Click="AddRule_Click" />
                                        </Grid>
                                        <DockPanel Margin="0,8,0,4">
                                            <TextBlock Style="{StaticResource Caption}" Text="Or pick a running app:" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <ComboBox x:Name="RunningAppsCombo" MinWidth="220" Width="260" HorizontalAlignment="Left"
                                                      DropDownOpened="RunningAppsCombo_DropDownOpened" SelectionChanged="RunningAppsCombo_SelectionChanged" />
                                        </DockPanel>
                                        <StackPanel x:Name="RulesList" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ======================= ABOUT ======================= -->
                            <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                                    <Grid>
                                        <Border Height="150" CornerRadius="13" Background="{StaticResource S.Wall}" VerticalAlignment="Top" />
                                        <StackPanel Margin="26,26,26,24">
                                            <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource S.AccentGradient}" HorizontalAlignment="Left">
                                                <Grid>
                                                    <Border Width="36" Height="13" CornerRadius="0,0,8,8" Background="#0E0E12"
                                                            VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,13,0,0" />
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14">
                                                        <Rectangle Width="5" Height="11" RadiusX="2.5" RadiusY="2.5" Fill="White" Margin="1.5,0" VerticalAlignment="Bottom" />
                                                        <Rectangle Width="5" Height="19" RadiusX="2.5" RadiusY="2.5" Fill="White" Margin="1.5,0" VerticalAlignment="Bottom" />
                                                        <Rectangle Width="5" Height="14" RadiusX="2.5" RadiusY="2.5" Fill="White" Margin="1.5,0" VerticalAlignment="Bottom" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="Crest" FontSize="30" FontWeight="Bold" Foreground="White" Margin="0,14,0,0" />
                                            <TextBlock x:Name="VersionText" Text="Version 1.4.0" Foreground="#D0FFFFFF" FontSize="13" />
                                            <TextBlock Text="A lightweight notch for Windows – time, music and controls at the top of your screen."
                                                       Style="{StaticResource Caption}" FontSize="13" Margin="0,28,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8"><Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Show the tour again" Click="ShowTour_Click" /><TextBlock Style="{StaticResource H2}" Text="Tips" VerticalAlignment="Center" /></DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7C9;" Foreground="#8B5CF6" Width="28" />
                                            <TextBlock Style="{StaticResource Caption}" FontSize="13" Text="Hover the notch to open the player." />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Foreground="#F59E0B" Width="28" />
                                            <TextBlock Style="{StaticResource Caption}" FontSize="13" Text="Right-click the notch to open these settings." />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" Foreground="#2DD4BF" Width="28" />
                                            <TextBlock Style="{StaticResource Caption}" FontSize="13" Text="Scroll on the notch to change the volume." />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" Foreground="#FF5E7E" Width="28" />
                                            <TextBlock Style="{StaticResource Caption}" FontSize="13" Text="Click the song title to jump to the app that's playing." />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" Foreground="#EF4444" Width="28" />
                                            <TextBlock Style="{StaticResource Caption}" FontSize="13" Text="Win + Alt + M mutes your microphone in every app." />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE722;" Foreground="#FFD60A" Width="28" />
                                            <TextBlock Style="{StaticResource Caption}" FontSize="13" Text="New screenshots wait for you on the shelf – drag them straight into a chat." />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Files" Margin="0,0,0,4" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Show file" Click="OpenSettingsFolder_Click" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Settings file" />
                                                <TextBlock x:Name="SettingsPathText" Style="{StaticResource RowDesc}" Text="settings.json" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Export…" Click="ExportSettings_Click" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Export settings" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Save your whole setup to a file – for another PC, or to share a look." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Import…" Click="ImportSettings_Click" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Import settings" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Load a setup someone exported. Your current settings are replaced." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Open folder" Click="OpenLogFolder_Click" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Error log" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Send this along if something goes wrong." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="Reset everything" Click="Reset_Click" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Reset to defaults" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Restores every setting to how Crest shipped." />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
