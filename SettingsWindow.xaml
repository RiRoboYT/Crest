<Window x:Class="Crest.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crest Settings"
        Width="960" Height="700"
        MinWidth="800" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource S.Bg}"
        Foreground="{DynamicResource S.Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Preview (mini notch) colors – overwritten from code. -->
            <SolidColorBrush x:Key="Pv.Bg" Color="Black" />
            <SolidColorBrush x:Key="Pv.Text" Color="White" />
            <SolidColorBrush x:Key="Pv.Sub" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="Pv.Track" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="Pv.Accent" Color="White" />
            <FontFamily x:Key="Pv.Font">Segoe UI</FontFamily>

            <Style x:Key="PvText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Pv.Text}" />
                <Setter Property="FontFamily" Value="{DynamicResource Pv.Font}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="PvIcon" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource Pv.Text}" />
                <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <LinearGradientBrush x:Key="Pv.ArtFallback" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF7A59" Offset="0" />
                <GradientStop Color="#C13BFF" Offset="0.5" />
                <GradientStop Color="#3B8CFF" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="RootBorder" BorderThickness="1" BorderBrush="{DynamicResource S.CardBorder}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================================================================ SIDEBAR -->
            <Border Grid.Column="0" Background="{DynamicResource S.Sidebar}"
                    BorderBrush="{DynamicResource S.Divider}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <!-- Brand -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,20,0,26">
                        <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource S.AccentGradient}">
                            <Grid>
                                <Border Width="22" Height="9" CornerRadius="0,0,5,5" Background="#0E0E12"
                                        VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,9">
                                    <Rectangle Width="3" Height="7" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1,0" VerticalAlignment="Bottom" />
                                    <Rectangle Width="3" Height="12" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1,0" VerticalAlignment="Bottom" />
                                    <Rectangle Width="3" Height="9" RadiusX="1.5" RadiusY="1.5" Fill="White" Margin="1,0" VerticalAlignment="Bottom" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Crest" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="Notch for Windows" Style="{StaticResource Caption}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Settings window theme -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,18">
                        <TextBlock Text="SETTINGS THEME" Style="{StaticResource Overline}" Margin="4,0,0,8" />
                        <Border Style="{StaticResource SegmentHost}">
                            <UniformGrid Columns="3">
                                <RadioButton x:Name="ThemeDark" GroupName="SettingsTheme" Style="{StaticResource Segment}"
                                             Tag="Dark" ToolTip="Dark" Checked="Theme_Checked" Padding="6,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE708;" />
                                        <TextBlock Text="Dark" Margin="6,0,0,0" FontSize="12" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ThemeLight" GroupName="SettingsTheme" Style="{StaticResource Segment}"
                                             Tag="Light" ToolTip="Light" Checked="Theme_Checked" Padding="6,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE706;" />
                                        <TextBlock Text="Light" Margin="6,0,0,0" FontSize="12" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ThemeSystem" GroupName="SettingsTheme" Style="{StaticResource Segment}"
                                             Tag="System" ToolTip="Follow Windows" Checked="Theme_Checked" Padding="6,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE7F4;" />
                                        <TextBlock Text="Auto" Margin="6,0,0,0" FontSize="12" />
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                        </Border>
                    </StackPanel>

                    <!-- Navigation -->
                    <ListBox x:Name="Nav" Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource NavItem}"
                             Margin="14,0" SelectionChanged="Nav_SelectionChanged"
                             PreviewMouseLeftButtonUp="Nav_PreviewMouseLeftButtonUp">
                        <ListBoxItem Tag="Appearance">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE790;" Width="28" />
                                <TextBlock Text="Appearance" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Size">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE740;" Width="28" />
                                <TextBlock Text="Size &amp; Shape" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Spectrum">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE9E9;" Width="28" />
                                <TextBlock Text="Spectrum" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Media">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8D6;" Width="28" />
                                <TextBlock Text="Media" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Behavior">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Width="28" />
                                <TextBlock Text="Behavior" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="About">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Width="28" />
                                <TextBlock Text="About" VerticalAlignment="Center" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ================================================================ CONTENT -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Caption buttons (the rest of the top strip drags the window) -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimize" Click="Minimize_Click" />
                    <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Close" Click="Close_Click" />
                </StackPanel>

                <ScrollViewer x:Name="PageScroller" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="36,0,36,32" MaxWidth="780">

                        <TextBlock x:Name="PageTitle" Style="{StaticResource H1}" Text="Appearance" />
                        <TextBlock x:Name="PageSubtitle" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,20"
                                   Text="Colors, presets and text." />

                        <!-- ======================= LIVE PREVIEW ======================= -->
                        <Border x:Name="PreviewCard" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel Margin="20,12,16,12">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource SegmentHost}">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="PvStateCollapsed" GroupName="PreviewState" Style="{StaticResource Segment}"
                                                             Content="Collapsed" IsChecked="True" Checked="PreviewState_Checked" />
                                                <RadioButton x:Name="PvStatePeek" GroupName="PreviewState" Style="{StaticResource Segment}"
                                                             Content="Peek" Checked="PreviewState_Checked" />
                                                <RadioButton x:Name="PvStateExpanded" GroupName="PreviewState" Style="{StaticResource Segment}"
                                                             Content="Expanded" Checked="PreviewState_Checked" />
                                            </StackPanel>
                                        </Border>
                                        <CheckBox x:Name="PinCheck" Style="{StaticResource Switch}" Margin="16,0,8,0"
                                                  ToolTip="Keep the real notch open while you edit"
                                                  Checked="PinCheck_Changed" Unchecked="PinCheck_Changed" />
                                        <TextBlock Text="Pin real notch" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Fill="#3DDC84" VerticalAlignment="Center" />
                                        <TextBlock Text="Live preview" Style="{StaticResource H2}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Fake desktop strip -->
                                <Border Grid.Row="1" Height="210" CornerRadius="0,0,13,13" ClipToBounds="True"
                                        Background="{StaticResource S.Wall}">
                                    <Grid x:Name="PreviewScreen">
                                        <Ellipse Width="420" Height="420" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                 Margin="-120,0,0,-260" Opacity="0.55">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="#FF5FA2" Offset="0" />
                                                    <GradientStop Color="#00FF5FA2" Offset="1" />
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Ellipse Width="360" Height="360" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                 Margin="0,-180,-80,0" Opacity="0.5">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="#4FC3FF" Offset="0" />
                                                    <GradientStop Color="#004FC3FF" Offset="1" />
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>

                                        <Viewbox Stretch="Uniform" VerticalAlignment="Top" HorizontalAlignment="Center">
                                            <Grid Width="1080" Height="330">
                                                <StackPanel x:Name="PvShapeRow" Orientation="Horizontal"
                                                            HorizontalAlignment="Center" VerticalAlignment="Top">
                                                    <Path x:Name="PvLeftShoulder" VerticalAlignment="Top" Width="10" Height="10" Stretch="Fill"
                                                          Fill="{DynamicResource Pv.Bg}" Data="M0,0 L10,0 L10,10 A10,10 0 0 0 0,0 Z" />

                                                    <Border x:Name="PvNotch" VerticalAlignment="Top" Width="220" Height="36"
                                                            Background="{DynamicResource Pv.Bg}" CornerRadius="0,0,14,14">
                                                        <Grid ClipToBounds="True">

                                                            <!-- collapsed -->
                                                            <Grid x:Name="PvCollapsed" HorizontalAlignment="Center" VerticalAlignment="Top">
                                                                <Grid Margin="16,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock x:Name="PvTime" Style="{StaticResource PvText}" FontWeight="SemiBold"
                                                                               VerticalAlignment="Center" Text="09:41 PM" />
                                                                    <StackPanel x:Name="PvCollapsedBars" Grid.Column="1" Orientation="Horizontal"
                                                                                VerticalAlignment="Center" Margin="10,0,0,0" />
                                                                </Grid>
                                                            </Grid>

                                                            <!-- peek -->
                                                            <Grid x:Name="PvPeek" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed">
                                                                <Grid Margin="12,0,16,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border x:Name="PvPeekArt" Width="36" Height="36" CornerRadius="9" Margin="0,0,10,0"
                                                                            Background="{StaticResource Pv.ArtFallback}" VerticalAlignment="Center" />
                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock x:Name="PvPeekTitle" Style="{StaticResource PvText}" FontWeight="SemiBold" Text="Song title" />
                                                                        <TextBlock x:Name="PvPeekArtist" Style="{StaticResource PvText}" Foreground="{DynamicResource Pv.Sub}" Text="Artist" />
                                                                    </StackPanel>
                                                                    <StackPanel x:Name="PvPeekBars" Grid.Column="2" Orientation="Horizontal"
                                                                                VerticalAlignment="Center" Margin="12,0,0,0" />
                                                                </Grid>
                                                            </Grid>

                                                            <!-- expanded -->
                                                            <Grid x:Name="PvExpanded" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed">
                                                                <Grid Margin="22,10,22,12">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="*" />
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <Grid>
                                                                        <TextBlock x:Name="PvDate" Style="{StaticResource PvText}" Foreground="{DynamicResource Pv.Sub}" Text="Thursday, Nov 6" />
                                                                        <TextBlock x:Name="PvExpandedTime" Style="{StaticResource PvText}" FontWeight="SemiBold"
                                                                                   HorizontalAlignment="Right" Text="09:41 PM" />
                                                                    </Grid>
                                                                    <Grid Grid.Row="1" Margin="0,8,0,6" VerticalAlignment="Center">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border x:Name="PvArt" Width="52" Height="52" CornerRadius="10" Margin="0,0,12,0"
                                                                                Background="{StaticResource Pv.ArtFallback}" />
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                            <TextBlock x:Name="PvTitle" Style="{StaticResource PvText}" FontWeight="SemiBold" Text="Song title" />
                                                                            <TextBlock x:Name="PvArtist" Style="{StaticResource PvText}" Foreground="{DynamicResource Pv.Sub}" Text="Artist" />
                                                                        </StackPanel>
                                                                        <StackPanel x:Name="PvExpandedBars" Grid.Column="2" Orientation="Horizontal"
                                                                                    VerticalAlignment="Center" Margin="12,0,0,0" />
                                                                    </Grid>
                                                                    <Grid x:Name="PvProgress" Grid.Row="2" Margin="0,0,0,4">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="40" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="40" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Style="{StaticResource PvText}" Foreground="{DynamicResource Pv.Sub}" Text="1:24" FontSize="11" VerticalAlignment="Center" />
                                                                        <Grid Grid.Column="1" VerticalAlignment="Center">
                                                                            <Border Height="4" CornerRadius="2" Background="{DynamicResource Pv.Track}" />
                                                                            <Border Height="4" CornerRadius="2" Background="{DynamicResource Pv.Accent}" HorizontalAlignment="Left" Width="110" />
                                                                        </Grid>
                                                                        <TextBlock Grid.Column="2" Style="{StaticResource PvText}" Foreground="{DynamicResource Pv.Sub}" Text="3:45"
                                                                                   FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                    <Grid Grid.Row="3" Height="34">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <StackPanel x:Name="PvVolume" Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <TextBlock Style="{StaticResource PvIcon}" Text="&#xE995;" FontSize="13" Margin="8,0,8,0" />
                                                                            <Grid Width="70" VerticalAlignment="Center">
                                                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource Pv.Track}" />
                                                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource Pv.Accent}" HorizontalAlignment="Left" Width="46" />
                                                                            </Grid>
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                            <TextBlock Style="{StaticResource PvIcon}" Text="&#xE892;" FontSize="15" Margin="10,0" />
                                                                            <TextBlock Style="{StaticResource PvIcon}" Text="&#xE769;" FontSize="20" Margin="10,0" />
                                                                            <TextBlock Style="{StaticResource PvIcon}" Text="&#xE893;" FontSize="15" Margin="10,0" />
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="2" Style="{StaticResource PvIcon}" Text="&#xE713;" FontSize="13"
                                                                                   HorizontalAlignment="Right" Margin="0,0,8,0" />
                                                                    </Grid>
                                                                </Grid>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>

                                                    <Path x:Name="PvRightShoulder" VerticalAlignment="Top" Width="10" Height="10" Stretch="Fill"
                                                          Fill="{DynamicResource Pv.Bg}" Data="M0,0 L10,0 L10,10 A10,10 0 0 0 0,0 Z"
                                                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <ScaleTransform ScaleX="-1" />
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </StackPanel>
                                            </Grid>
                                        </Viewbox>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- ============================================================ PAGES -->
                        <Grid x:Name="PagesHost">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="PagesShift" />
                            </Grid.RenderTransform>

                            <!-- ======================= APPEARANCE ======================= -->
                            <StackPanel x:Name="PageAppearance">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <StackPanel Style="{StaticResource CardHeader}">
                                            <TextBlock Style="{StaticResource H2}" Text="Presets" />
                                            <TextBlock Style="{StaticResource Caption}" Text="One click to change the whole look. Sizes are kept." />
                                        </StackPanel>
                                        <UniformGrid x:Name="PresetHost" Columns="4" Margin="0,6,0,4" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Colors" Margin="0,0,0,4" />

                                        <DockPanel Style="{StaticResource Row}">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <TextBox Width="112" Text="{Binding BackgroundColor, UpdateSourceTrigger=LostFocus}" />
                                                <Button Style="{StaticResource SwatchButton}" Margin="8,0,0,0" Tag="BackgroundColor" Click="PickColor_Click"
                                                        Background="{Binding BackgroundColor, Converter={StaticResource HexToBrush}}" />
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Background" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Color of the notch itself." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />

                                        <StackPanel Style="{StaticResource SliderRow}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource ValuePill}">
                                                    <TextBlock Style="{StaticResource ValueText}" Text="{Binding BackgroundOpacity, StringFormat=P0}" />
                                                </Border>
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Background opacity" />
                                            </DockPanel>
                                            <Slider Minimum="0.1" Maximum="1" SmallChange="0.01" LargeChange="0.1" Margin="0,6,0,0"
                                                    Value="{Binding BackgroundOpacity}" />
                                        </StackPanel>
                                        <Border Style="{StaticResource Divider}" />

                                        <DockPanel Style="{StaticResource Row}">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <TextBox Width="112" Text="{Binding TextColor, UpdateSourceTrigger=LostFocus}" />
                                                <Button Style="{StaticResource SwatchButton}" Margin="8,0,0,0" Tag="TextColor" Click="PickColor_Click"
                                                        Background="{Binding TextColor, Converter={StaticResource HexToBrush}}" />
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Text &amp; icons" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Time, titles and buttons." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />

                                        <DockPanel Style="{StaticResource Row}">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <TextBox Width="112" Text="{Binding AccentColor, UpdateSourceTrigger=LostFocus}" />
                                                <Button Style="{StaticResource SwatchButton}" Margin="8,0,0,0" Tag="AccentColor" Click="PickColor_Click"
                                                        Background="{Binding AccentColor, Converter={StaticResource HexToBrush}}" />
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Progress &amp; volume" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Fill color of the progress bar and volume slider." />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Text" Margin="0,0,0,4" />

                                        <DockPanel Style="{StaticResource Row}">
                                            <ComboBox x:Name="FontCombo" DockPanel.Dock="Right" Width="230"
                                                      SelectedItem="{Binding FontFamily}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="13" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Font" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Used for the clock and song info." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />

                                        <StackPanel Style="{StaticResource SliderRow}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource ValuePill}">
                                                    <TextBlock Style="{StaticResource ValueText}">
                                                        <Run Text="{Binding FontSize, StringFormat=0.#, Mode=OneWay}" /><Run Text=" pt" />
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Font size" />
                                            </DockPanel>
                                            <Slider Minimum="8" Maximum="24" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,6,0,0"
                                                    Value="{Binding FontSize}" />
                                        </StackPanel>
                                        <Border Style="{StaticResource Divider}" />

                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Use24HourClock}" />
                                            <TextBlock Style="{StaticResource RowTitle}" Text="24-hour clock" />
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowSeconds}" />
                                            <TextBlock Style="{StaticResource RowTitle}" Text="Show seconds" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ======================= SIZE & SHAPE ======================= -->
                            <StackPanel x:Name="PageSize" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Shape" Margin="0,0,0,4" />

                                        <DockPanel Style="{StaticResource Row}">
                                            <Border DockPanel.Dock="Right" Style="{StaticResource SegmentHost}">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="ShapeNotch" GroupName="Shape" Style="{StaticResource Segment}"
                                                                 Content="Notch" Tag="Notch" Checked="Shape_Checked" Padding="16,6" />
                                                    <RadioButton x:Name="ShapePill" GroupName="Shape" Style="{StaticResource Segment}"
                                                                 Content="Pill" Tag="Pill" Checked="Shape_Checked" Padding="16,6" />
                                                </StackPanel>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Style" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Notch hugs the top edge; Pill floats below it." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />

                                        <StackPanel Style="{StaticResource SliderRow}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource ValuePill}">
                                                    <TextBlock Style="{StaticResource ValueText}"><Run Text="{Binding CornerRadius, StringFormat=0, Mode=OneWay}" /><Run Text=" px" /></TextBlock>
                                                </Border>
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Corner radius" />
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0" Value="{Binding CornerRadius}" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource SliderRow}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource ValuePill}">
                                                    <TextBlock Style="{StaticResource ValueText}"><Run Text="{Binding ExpandedCornerRadius, StringFormat=0, Mode=OneWay}" /><Run Text=" px" /></TextBlock>
                                                </Border>
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Expanded corner radius" />
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0" Value="{Binding ExpandedCornerRadius}" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource SliderRow}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource ValuePill}">
                                                    <TextBlock Style="{StaticResource ValueText}"><Run Text="{Binding ShoulderSize, StringFormat=0, Mode=OneWay}" /><Run Text=" px" /></TextBlock>
                                                </Border>
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Shoulder curve (Notch)" />
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0" Value="{Binding ShoulderSize}" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource SliderRow}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource ValuePill}">
                                                    <TextBlock Style="{StaticResource ValueText}"><Run Text="{Binding TopMargin, StringFormat=0, Mode=OneWay}" /><Run Text=" px" /></TextBlock>
                                                </Border>
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Gap from the top (Pill)" />
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0" Value="{Binding TopMargin}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Size" Margin="0,0,0,4" />
                                        <StackPanel Style="{StaticResource SliderRow}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource ValuePill}">
                                                    <TextBlock Style="{StaticResource ValueText}"><Run Text="{Binding CollapsedWidth, StringFormat=0, Mode=OneWay}" /><Run Text=" px" /></TextBlock>
                                                </Border>
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Collapsed width" />
                                            </DockPanel>
                                            <Slider Minimum="100" Maximum="600" TickFrequency="2" IsSnapToTickEnabled="True" Margin="0,6,0,0" Value="{Binding CollapsedWidth}" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource SliderRow}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource ValuePill}">
                                                    <TextBlock Style="{StaticResource ValueText}"><Run Text="{Binding CollapsedHeight, StringFormat=0, Mode=OneWay}" /><Run Text=" px" /></TextBlock>
                                                </Border>
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Collapsed height" />
                                            </DockPanel>
                                            <Slider Minimum="20" Maximum="80" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0" Value="{Binding CollapsedHeight}" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource SliderRow}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource ValuePill}">
                                                    <TextBlock Style="{StaticResource ValueText}"><Run Text="{Binding ExpandedWidth, StringFormat=0, Mode=OneWay}" /><Run Text=" px" /></TextBlock>
                                                </Border>
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Expanded width" />
                                            </DockPanel>
                                            <Slider Minimum="300" Maximum="800" TickFrequency="2" IsSnapToTickEnabled="True" Margin="0,6,0,0" Value="{Binding ExpandedWidth}" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource SliderRow}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource ValuePill}">
                                                    <TextBlock Style="{StaticResource ValueText}"><Run Text="{Binding ExpandedHeight, StringFormat=0, Mode=OneWay}" /><Run Text=" px" /></TextBlock>
                                                </Border>
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Expanded height" />
                                            </DockPanel>
                                            <Slider Minimum="140" Maximum="320" TickFrequency="2" IsSnapToTickEnabled="True" Margin="0,6,0,0" Value="{Binding ExpandedHeight}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Position" Margin="0,0,0,4" />

                                        <DockPanel Style="{StaticResource Row}">
                                            <ComboBox x:Name="MonitorCombo" DockPanel.Dock="Right" Width="300"
                                                      DisplayMemberPath="Label" SelectedValuePath="Id"
                                                      SelectionChanged="MonitorCombo_SelectionChanged"
                                                      DropDownOpened="MonitorCombo_DropDownOpened" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Show on monitor" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Crest stays sharp on any scaling." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />

                                        <StackPanel Style="{StaticResource SliderRow}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Center"
                                                        Padding="12,3" Margin="10,0,0,0" Click="CenterOffset_Click" />
                                                <Border DockPanel.Dock="Right" Style="{StaticResource ValuePill}">
                                                    <TextBlock Style="{StaticResource ValueText}"><Run Text="{Binding HorizontalOffset, StringFormat=0, Mode=OneWay}" /><Run Text=" px" /></TextBlock>
                                                </Border>
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Horizontal offset" />
                                            </DockPanel>
                                            <Slider Minimum="-1200" Maximum="1200" TickFrequency="2" IsSnapToTickEnabled="True" Margin="0,6,0,0" Value="{Binding HorizontalOffset}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ======================= SPECTRUM ======================= -->
                            <StackPanel x:Name="PageSpectrum" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Mode" Margin="0,0,0,4" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding RealSpectrum}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="React to the real sound" />
                                                <TextBlock Style="{StaticResource RowDesc}"
                                                           Text="Bars follow what's actually playing. Uses a little more CPU while music plays. Off = lightweight fake animation." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowSpectrumWhenExpanded}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Show next to the song title" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="In the expanded player." />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Bars" Margin="0,0,0,4" />

                                        <DockPanel Style="{StaticResource Row}">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <TextBox Width="112" Text="{Binding SpectrumColor, UpdateSourceTrigger=LostFocus}" />
                                                <Button Style="{StaticResource SwatchButton}" Margin="8,0,0,0" Tag="SpectrumColor" Click="PickColor_Click"
                                                        Background="{Binding SpectrumColor, Converter={StaticResource HexToBrush}}" />
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Color" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Ignored while &quot;Colors from album art&quot; is on." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />

                                        <StackPanel Style="{StaticResource SliderRow}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource ValuePill}">
                                                    <TextBlock Style="{StaticResource ValueText}" Text="{Binding SpectrumBarCount}" />
                                                </Border>
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Number of bars" />
                                            </DockPanel>
                                            <Slider Minimum="3" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0" Value="{Binding SpectrumBarCount}" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource SliderRow}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource ValuePill}">
                                                    <TextBlock Style="{StaticResource ValueText}"><Run Text="{Binding SpectrumBarWidth, StringFormat=0.#, Mode=OneWay}" /><Run Text=" px" /></TextBlock>
                                                </Border>
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Bar thickness" />
                                            </DockPanel>
                                            <Slider Minimum="1" Maximum="8" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,6,0,0" Value="{Binding SpectrumBarWidth}" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource SliderRow}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource ValuePill}">
                                                    <TextBlock Style="{StaticResource ValueText}"><Run Text="{Binding SpectrumBarSpacing, StringFormat=0.#, Mode=OneWay}" /><Run Text=" px" /></TextBlock>
                                                </Border>
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Bar spacing" />
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="8" TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="0,6,0,0" Value="{Binding SpectrumBarSpacing}" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource SliderRow}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource ValuePill}">
                                                    <TextBlock Style="{StaticResource ValueText}"><Run Text="{Binding SpectrumMaxHeight, StringFormat=0, Mode=OneWay}" /><Run Text=" px" /></TextBlock>
                                                </Border>
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Max bar height" />
                                            </DockPanel>
                                            <Slider Minimum="6" Maximum="40" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,6,0,0" Value="{Binding SpectrumMaxHeight}" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource SliderRow}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource ValuePill}">
                                                    <TextBlock Style="{StaticResource ValueText}"><Run Text="{Binding SpectrumSpeedMs, Mode=OneWay}" /><Run Text=" ms" /></TextBlock>
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource RowTitle}" Text="Animation speed (fake mode)" />
                                                    <TextBlock Style="{StaticResource RowDesc}" Text="How often the bars pick new heights. Lower = faster." />
                                                </StackPanel>
                                            </DockPanel>
                                            <Slider Minimum="40" Maximum="300" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,6,0,0" Value="{Binding SpectrumSpeedMs}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ======================= MEDIA ======================= -->
                            <StackPanel x:Name="PageMedia" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Now playing" Margin="0,0,0,4" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding PreferPlayingSession}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Follow the app that's playing" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="If Spotify is paused and YouTube is playing, show YouTube." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding UseAlbumColors}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Colors from album art" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Spectrum and progress bar take the main color of the cover." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ClickToOpenApp}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Click the song to open the app" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Brings Spotify / your browser to the front. Browsers open the window, not the exact tab." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ScrollLongTitles}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Scroll long titles" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Titles that don't fit slide across instead of being cut off." />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Song-change peek" Margin="0,0,0,4" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding PeekOnTrackChange}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Peek when a new song starts" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="The notch briefly opens to show the cover and title." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <StackPanel Style="{StaticResource SliderRow}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource ValuePill}">
                                                    <TextBlock Style="{StaticResource ValueText}"><Run Text="{Binding PeekDurationMs, Converter={StaticResource MsToSeconds}, StringFormat=0.#, Mode=OneWay}" /><Run Text=" s" /></TextBlock>
                                                </Border>
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Peek duration" />
                                            </DockPanel>
                                            <Slider Minimum="1000" Maximum="10000" TickFrequency="500" IsSnapToTickEnabled="True" Margin="0,6,0,0"
                                                    Value="{Binding PeekDurationMs}" IsEnabled="{Binding PeekOnTrackChange}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Expanded player" Margin="0,0,0,4" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowDate}" />
                                            <TextBlock Style="{StaticResource RowTitle}" Text="Show date" />
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowAlbumArt}" />
                                            <TextBlock Style="{StaticResource RowTitle}" Text="Show album art" />
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowProgress}" />
                                            <TextBlock Style="{StaticResource RowTitle}" Text="Show progress bar" />
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ShowVolumeIcon}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Show volume controls" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Mute button and a slider for the Windows volume." />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ======================= BEHAVIOR ======================= -->
                            <StackPanel x:Name="PageBehavior" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="General" Margin="0,0,0,4" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Start with Windows" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Launch Crest automatically when you sign in." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding AlwaysOnTop}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Always on top" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Stays above fullscreen videos and borderless games." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ScrollChangesVolume}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Scroll on the notch changes volume" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Mouse wheel up / down over the notch." />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Hover &amp; animation" Margin="0,0,0,4" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ExpandOnHover}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Open on hover" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Off = click the notch to open it." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <StackPanel Style="{StaticResource SliderRow}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource ValuePill}">
                                                    <TextBlock Style="{StaticResource ValueText}"><Run Text="{Binding HoverDelayMs, Mode=OneWay}" /><Run Text=" ms" /></TextBlock>
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource RowTitle}" Text="Hover delay" />
                                                    <TextBlock Style="{StaticResource RowDesc}" Text="How long the mouse must rest on the notch before it opens." />
                                                </StackPanel>
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="800" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,6,0,0"
                                                    Value="{Binding HoverDelayMs}" IsEnabled="{Binding ExpandOnHover}" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource SliderRow}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource ValuePill}">
                                                    <TextBlock Style="{StaticResource ValueText}"><Run Text="{Binding CollapseDelayMs, Mode=OneWay}" /><Run Text=" ms" /></TextBlock>
                                                </Border>
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Close delay" />
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="1000" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,6,0,0" Value="{Binding CollapseDelayMs}" />
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource SliderRow}">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Right" Style="{StaticResource ValuePill}">
                                                    <TextBlock Style="{StaticResource ValueText}"><Run Text="{Binding AnimationDurationMs, Mode=OneWay}" /><Run Text=" ms" /></TextBlock>
                                                </Border>
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Animation duration" />
                                            </DockPanel>
                                            <Slider Minimum="0" Maximum="600" TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,6,0,0" Value="{Binding AnimationDurationMs}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ======================= ABOUT ======================= -->
                            <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                                <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                                    <Grid>
                                        <Border Height="150" CornerRadius="13" Background="{StaticResource S.Wall}" VerticalAlignment="Top" />
                                        <StackPanel Margin="26,26,26,24">
                                            <Border Width="64" Height="64" CornerRadius="18" Background="{DynamicResource S.AccentGradient}" HorizontalAlignment="Left">
                                                <Grid>
                                                    <Border Width="36" Height="13" CornerRadius="0,0,8,8" Background="#0E0E12"
                                                            VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,13,0,0" />
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14">
                                                        <Rectangle Width="5" Height="11" RadiusX="2.5" RadiusY="2.5" Fill="White" Margin="1.5,0" VerticalAlignment="Bottom" />
                                                        <Rectangle Width="5" Height="19" RadiusX="2.5" RadiusY="2.5" Fill="White" Margin="1.5,0" VerticalAlignment="Bottom" />
                                                        <Rectangle Width="5" Height="14" RadiusX="2.5" RadiusY="2.5" Fill="White" Margin="1.5,0" VerticalAlignment="Bottom" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <TextBlock Text="Crest" FontSize="30" FontWeight="Bold" Foreground="White" Margin="0,14,0,0" />
                                            <TextBlock x:Name="VersionText" Text="Version 1.1.0" Foreground="#D0FFFFFF" FontSize="13" />
                                            <TextBlock Text="A lightweight notch for Windows – time, music and controls at the top of your screen."
                                                       Style="{StaticResource Caption}" FontSize="13" Margin="0,28,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Tips" Margin="0,0,0,8" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7C9;" Foreground="{DynamicResource S.Accent}" Width="28" />
                                            <TextBlock Style="{StaticResource Caption}" FontSize="13" Text="Hover the notch to open the player." />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Foreground="{DynamicResource S.Accent}" Width="28" />
                                            <TextBlock Style="{StaticResource Caption}" FontSize="13" Text="Right-click the notch to open these settings." />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" Foreground="{DynamicResource S.Accent}" Width="28" />
                                            <TextBlock Style="{StaticResource Caption}" FontSize="13" Text="Scroll on the notch to change the volume." />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" Foreground="{DynamicResource S.Accent}" Width="28" />
                                            <TextBlock Style="{StaticResource Caption}" FontSize="13" Text="Click the song title to jump to the app that's playing." />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource H2}" Text="Files" Margin="0,0,0,4" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Show file" Click="OpenSettingsFolder_Click" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Settings file" />
                                                <TextBlock x:Name="SettingsPathText" Style="{StaticResource RowDesc}" Text="settings.json" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Open folder" Click="OpenLogFolder_Click" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Error log" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Send this along if something goes wrong." />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Style="{StaticResource Divider}" />
                                        <DockPanel Style="{StaticResource Row}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Content="Reset everything" Click="Reset_Click" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource RowTitle}" Text="Reset to defaults" />
                                                <TextBlock Style="{StaticResource RowDesc}" Text="Restores every setting to how Crest shipped." />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
